# Authority Admin Portal Credentials
# Set a custom strong passcode for deployment
ADMIN_PASSWORD=Admin@RoadGuardian2026

# MySQL Database Configuration (Optional - falls back to local SQLite if unreachable)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=road_guardian_db

# ==========================================
# AUTHENTICATION CONFIGURATION
# ==========================================

# Secure JWT Session Sign Secret Key (Required)
JWT_SECRET=your_super_secret_jwt_key_here

# SMTP Configuration (Optional - if empty, sends verification and reset emails to terminal console logs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Road Guardian AI Support

# Google OAuth 2.0 Credentials (Optional - if empty, switches automatically to Mock Google Consent sandbox picker)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
